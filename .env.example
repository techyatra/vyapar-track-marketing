# Copy to .env for local runs. In CI, these are GitHub Secrets instead.

# Content generation
GEMINI_API_KEY=

# Supabase (state: topics, drafts, approval queue, schedules, analytics, oauth tokens)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LinkedIn (same OAuth pattern as techyatra/Linkedin-Automator)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORG_URN=

# Meta Graph API (Instagram + Facebook) — requires IG Business account linked to a FB Page
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=

# YouTube Data API (same pattern as techyatra/youtube-automator)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Approval dashboard auth (the one person allowed to approve/reject drafts)
APPROVER_EMAIL=hello.vyapartrack@gmail.com
