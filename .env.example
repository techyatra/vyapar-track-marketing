# Copy to .env for local runs. In CI, these are GitHub Secrets instead.

# Content generation
GEMINI_API_KEY=

# Supabase — SAME project as techyatra/Linkedin-Automator (shared by choice).
# Copy these from Azure Portal -> Function App "linkedin-automator-daily-post"
# -> Configuration, or supabase.com dashboard -> that project -> Settings -> API.
# All tables this engine touches are vt_-prefixed (see supabase/schema.sql),
# so they can't collide with Linkedin-Automator's own tables in that project.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LinkedIn — SAME app + identity as techyatra/Linkedin-Automator (shared by
# choice). Copy LINKEDIN_CLIENT_ID/SECRET/ACCESS_TOKEN/PERSON_URN from
# wherever Linkedin-Automator's production token actually lives: check Azure
# App Settings first (legacy single-user path), and if not there, it's
# multi-tenant — look in the shared Supabase project's user_automation_settings
# table (linkedin_refresh_token column) for your own user row.
# NOTE: VyaparTrack marketing posts will appear on the SAME LinkedIn
# profile/page Linkedin-Automator already posts dev content to.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORG_URN=

# Meta Graph API (Instagram + Facebook) — requires IG Business account linked to a FB Page
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=

# YouTube Data API (same pattern as techyatra/youtube-automator)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Approval dashboard auth (the one person allowed to approve/reject drafts)
APPROVER_EMAIL=hello.vyapartrack@gmail.com
